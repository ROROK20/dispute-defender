# ── PayPal (sandbox only) ─────────────────────────────────────────────
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Printed by `npm run webhook:register`
PAYPAL_WEBHOOK_ID=
# Same value as PAYPAL_CLIENT_ID; exposed to the storefront Checkout buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ── Anthropic ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_AGENT=claude-sonnet-5-5
ANTHROPIC_MODEL_REVIEW=claude-opus-5-5
REVIEW_ENABLED=true

# ── App ───────────────────────────────────────────────────────────────
DATABASE_PATH=./data/app.db
# Public HTTPS origin PayPal can reach (Render URL or ngrok URL), no trailing slash
PUBLIC_BASE_URL=http://localhost:3000

# ── Expected-value inputs (the seller sets their own fee schedule) ───
# Set this to the dispute/chargeback fee from YOUR PayPal fee schedule.
# Left at 0, the fight-or-refund math leaves out any dispute fee.
DISPUTE_FEE_USD=0
# Assumption: what an hour of the seller's time is worth to them. Edit to taste.
SELLER_TIME_COST_USD=15

# ── Demo trigger rate limits ──────────────────────────────────────────
# Enough for one judge to retry and a small panel to try it in the same hour.
DEMO_TRIGGER_PER_IP_PER_MIN=3
DEMO_TRIGGER_GLOBAL_PER_HOUR=30

# ── Test / CI only. Both show a red MOCK MODE banner in the UI. ──────
PAYPAL_MOCK=0
ANTHROPIC_MOCK=0

# ── Poller fallback for slow webhook delivery ─────────────────────────
POLL_INTERVAL_MS=30000
